# ============================================================================
# Hosting Platform - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to Git.
# ============================================================================

# ---------------------------------------------------------------------------- App
APP_ENV=development
APP_DEBUG=true
APP_NAME=Hosting Platform
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ---------------------------------------------------------------------------- Security (REQUIRED - generate these)
# JWT signing secret. Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-64-chars

# Fernet key for encrypting credentials at rest. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key-32-url-safe-base64-bytes

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------- Database
# SQLite for development. PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/hosting
DATABASE_URL=sqlite:///./hosting.db

# ---------------------------------------------------------------------------- Frontend / CORS / Cookies
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------- Rate limiting
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------- Email (optional - for password reset & verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Hosting Platform
EMAIL_VERIFICATION_REQUIRED=false

# ---------------------------------------------------------------------------- Discord (required for Discord ordering)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STAFF_ROLE_IDS=
DISCORD_ORDER_CHANNEL_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_NOTIFICATIONS_CHANNEL_ID=
DISCORD_INVITE_URL=https://discord.gg/your-invite
BACKEND_URL=http://localhost:8000
BOT_API_KEY=replace-with-a-long-random-secret-for-bot-backend-auth
DISCORD_REDIRECT_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------- Pterodactyl (connect to your existing panel)
PTERODACTYL_URL=https://panel.yourdomain.com
PTERODACTYL_APP_API_KEY=
PTERODACTYL_API_TIMEOUT=30
PTERODACTYL_DEFAULT_NODE_ID=
PTERODACTYL_DEFAULT_LOCATION_ID=
PTERODACTYL_DEFAULT_NEST_ID=
PTERODACTYL_DEFAULT_EGG_ID=
PTERODACTYL_DEFAULT_RAM=1024
PTERODACTYL_DEFAULT_CPU=100
PTERODACTYL_DEFAULT_STORAGE=20480
PTERODACTYL_DEFAULT_DISK=20480
PTERODACTYL_DEFAULT_IO=500
PTERODACTYL_DEFAULT_OVERLIMIT=false

# ---------------------------------------------------------------------------- Provisioning
PROVISIONING_MAX_ATTEMPTS=5
PROVISIONING_RETRY_BACKOFF_SECONDS=30
